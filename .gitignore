# .gitignore — two kinds of things stay out of git:
#
#   1. LOCAL-ONLY MATERIAL: everything you put in by hand that can't or shouldn't be public
#      (vendor datasheets, the TI-81 guidebook, teardown photos, downloaded KiCad libraries).
#      It all lives in ONE folder, /_reference/. See "What's not in this repo" in README.md.
#
#   2. GENERATED FILES: build output, caches, backups and editor/tool settings. Tools write
#      these next to the sources, so they are ignored by pattern wherever they appear.

# ── 1. Local-only material ────────────────────────────────────────────────────
/_reference/

# ── 2. Generated files ────────────────────────────────────────────────────────

# Firmware build output
/build/
*.elf
*.bin
*.hex
*.map
*.lst
*.o
*.obj

# Host test build output (regenerated by: cmake -S App/Tests -B build-tests)
/build-tests/

# gcov / lcov coverage output (appears alongside sources)
*.gcov
*.gcda
*.gcno
/lcov.info
/coverage/

# STM32CubeMX internal and Eclipse project files (not needed for CMake builds)
/.mxproject
/mx.scratch
/.project
/.cproject
/.settings/

# LVGL parts not needed for the embedded build
Middlewares/Third_Party/lvgl/tests/
Middlewares/Third_Party/lvgl/docs/
Middlewares/Third_Party/lvgl/examples/
Middlewares/Third_Party/lvgl/demos/
Middlewares/Third_Party/lvgl/scripts/
Middlewares/Third_Party/lvgl/libs/
Middlewares/Third_Party/lvgl/env_support/
Middlewares/Third_Party/lvgl/.github/
Middlewares/Third_Party/lvgl/.devcontainer/
# (STM32 vendor libraries under Drivers/ ARE committed so the CI firmware build works.)

# KiCad / FreeCAD caches, lock files and local backups (design files themselves are committed)
hardware/**/*-backups/
hardware/**/*.kicad_prl
hardware/**/fp-info-cache
hardware/**/*-bkp-*.kicad_pcb-bak
hardware/**/*.kicad_sch_old
hardware/**/*.lck
hardware/**/*.FCBak
hardware/**/jlcpcb/project.db

# Editor and AI-assistant tool settings (personal; tools expect them at the repo root)
/.vscode/
/.claude/
/.agents/
/skills-lock.json

# macOS metadata (appears in every directory)
.DS_Store
